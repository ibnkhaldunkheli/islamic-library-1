# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API

# Safe to expose in the browser (protected by Row Level Security, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The email address of the ONE account that should be treated as the owner/admin.
# This must match the email of the account you sign up with in Supabase Auth.
NEXT_PUBLIC_OWNER_EMAIL=you@example.com

# NEVER put the service_role key in NEXT_PUBLIC_* variables or in any client file.
# It is not used by this app's client code. If you ever add server-only admin
# scripts, keep the service_role key server-side only and out of git.
